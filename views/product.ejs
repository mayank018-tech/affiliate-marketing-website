<!-- Product Detail -->
<!-- Product Detail -->
<section class="py-20 min-h-[calc(100vh-200px)] flex items-center relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-indigo-50/50 via-white to-purple-50/50 -z-10"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="grid md:grid-cols-2 gap-16 items-start">
            <div class="relative group">
                <% 
                   let urls = [];
                   if (product.image_urls) {
                       try { urls = JSON.parse(product.image_urls); } catch(e) {}
                   }
                   if (urls.length === 0 && product.image_url) urls.push(product.image_url);
                   if (urls.length === 0) urls.push('https://via.placeholder.com/600x400');
                %>
                
                <div class="absolute -inset-4 bg-gradient-to-r from-primary to-secondary rounded-[2.5rem] blur-xl opacity-20 group-hover:opacity-40 transition-opacity duration-700"></div>
                <img id="main-product-image" src="<%= urls[0] %>" alt="<%= product.title %>" class="relative w-full rounded-[2rem] shadow-2xl object-cover aspect-video sm:aspect-square md:aspect-auto">
                <% if (product.badge) { %>
                    <div class="absolute top-8 right-8 bg-gradient-to-r from-accent to-pink-500 text-white px-5 py-2 rounded-full text-sm font-bold uppercase tracking-widest shadow-xl shadow-pink-500/40 transform -rotate-2">
                        <%= product.badge %>
                    </div>
                <% } %>
                
                <% if (urls.length > 1) { %>
                    <div class="flex gap-4 mt-6 overflow-x-auto pb-2 relative z-10">
                        <% urls.forEach((url, i) => { %>
                            <button type="button" class="flex-shrink-0 thumbnail-btn <%= i===0 ? 'ring-2 ring-primary ring-offset-2' : 'opacity-70 hover:opacity-100' %> rounded-xl overflow-hidden transition-all" data-img="<%= url %>">
                                <img src="<%= url %>" class="w-20 h-20 object-cover">
                            </button>
                        <% }) %>
                    </div>
                <% } %>
            </div>
            
            <div class="space-y-8 relative">
                <a href="/category/<%= product.category_slug %>" class="text-sm text-primary font-bold uppercase tracking-widest bg-indigo-50/80 backdrop-blur-sm border border-indigo-100 px-4 py-2 rounded-full inline-block hover:bg-indigo-100 transition-colors">
                    <%= product.category_name %>
                </a>
                
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 leading-tight tracking-tight">
                    <%= product.title %>
                </h1>
                
                <p class="text-lg md:text-xl text-slate-600 leading-relaxed font-light">
                    <%= product.description %>
                </p>
                
                <div class="pt-8 border-t border-slate-200/60">
                    <div class="flex items-center gap-6 mb-10">
                    <span class="text-4xl font-black text-slate-800 price-display" data-price="<%= product.price %>">$<%= product.price %></span>
                    <% if (product.badge) { %>
                        <span class="bg-indigo-50 text-indigo-700 px-4 py-1.5 rounded-full text-sm font-bold"><%= product.badge %></span>
                    <% } %>
                </div>    
                    <a href="<%= product.affiliate_link %>" target="_blank" rel="noopener noreferrer" class="group relative inline-flex items-center justify-center px-10 py-5 text-lg font-bold text-white transition-all duration-300 bg-gray-900 rounded-2xl hover:bg-primary focus:outline-none focus:ring-4 focus:ring-primary/50 w-full sm:w-auto shadow-[0_10px_30px_rgba(0,0,0,0.2)] hover:shadow-[0_10px_40px_rgba(79,70,229,0.5)] overflow-hidden">
                        <span class="absolute inset-0 w-full h-full -mt-1 rounded-lg opacity-30 bg-gradient-to-b from-transparent via-transparent to-black"></span>
                        <span class="relative flex items-center">
                            <i class="fas fa-shopping-cart mr-3 group-hover:scale-110 transition-transform"></i> Get this Deal
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const mainImg = document.getElementById('main-product-image');
        const thumbs = document.querySelectorAll('.thumbnail-btn');
        
        thumbs.forEach(btn => {
            btn.addEventListener('click', () => {
                // Update main image src
                mainImg.src = btn.getAttribute('data-img');
                
                // Update styling
                thumbs.forEach(t => {
                    t.classList.remove('ring-2', 'ring-primary', 'ring-offset-2');
                    t.classList.add('opacity-70', 'hover:opacity-100');
                });
                btn.classList.add('ring-2', 'ring-primary', 'ring-offset-2');
                btn.classList.remove('opacity-70', 'hover:opacity-100');
            });
        });
    });
</script>

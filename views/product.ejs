<!-- Product Detail -->
<section class="py-20 min-h-[calc(100vh-200px)] flex items-center relative overflow-hidden transition-colors duration-300">
    <div class="absolute inset-0 bg-gradient-to-br from-indigo-50/50 via-white to-purple-50/50 dark:from-[#1F150C] dark:via-[#000000]/60 dark:to-[#1F150C] -z-10"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="grid md:grid-cols-2 gap-8 md:gap-16 items-start">
            <div class="relative group mt-4 md:mt-0">
                <% 
                   let urls = [];
                   if (product.image_urls) {
                       try { urls = JSON.parse(product.image_urls); } catch(e) {}
                   }
                   if (urls.length === 0 && product.image_url) urls.push(product.image_url);
                   if (urls.length === 0) urls.push('https://via.placeholder.com/600x400');

                   // Dynamic description formatting
                   let formattedDesc = '';
                   if (product.description) {
                       const lines = product.description.split('\n');
                       let inList = false;
                       lines.forEach(line => {
                           const trimmed = line.trim();
                           if (trimmed.startsWith('-') || trimmed.startsWith('•')) {
                               if (!inList) {
                                   formattedDesc += '<ul class="space-y-2 mt-2 mb-4">';
                                   inList = true;
                               }
                               const itemText = trimmed.replace(/^[-•]\s*/, '');
                               formattedDesc += `<li class="flex items-start text-slate-700 dark:text-slate-300 text-sm md:text-base"><span class="text-primary dark:text-indigo-400 mr-2.5 mt-1 flex-shrink-0"><i class="fas fa-check-circle text-xs"></i></span><span>${itemText}</span></li>`;
                           } else {
                               if (inList) {
                                   formattedDesc += '</ul>';
                                   inList = false;
                               }
                               if (trimmed !== '') {
                                   formattedDesc += `<p class="text-slate-700 dark:text-slate-300 leading-relaxed text-sm md:text-base mb-3">${trimmed}</p>`;
                               }
                           }
                       });
                       if (inList) {
                           formattedDesc += '</ul>';
                       }
                   }

                   // Generate details based on product type
                   let specs = [];
                   const catName = (product.category_name || '').toLowerCase();
                   
                   if (catName.includes('tech') || catName.includes('gaming') || catName.includes('gadgets')) {
                       specs = [
                           { label: 'Connectivity', value: 'Wireless Bluetooth & Wired USB-C' },
                           { label: 'Compatibility', value: 'Windows, macOS, iOS, Android' },
                           { label: 'Power Source', value: 'Rechargeable Battery / USB input' },
                           { label: 'Color Theme', value: 'Obsidian Black / Charcoal RGB' },
                           { label: 'Material Quality', value: 'Reinforced Space-Grade ABS' }
                       ];
                       if (product.title.toLowerCase().includes('keyboard')) {
                           specs.push({ label: 'Key Switches', value: 'Mechanical Tactile Brown' });
                           specs.push({ label: 'Backlighting', value: 'Dynamic 16.8M Color RGB' });
                       } else if (product.title.toLowerCase().includes('headphone') || product.title.toLowerCase().includes('audio')) {
                           specs.push({ label: 'Battery Life', value: 'Up to 30 Hours Playtime' });
                           specs.push({ label: 'Sound Isolation', value: 'Active Noise Cancelling (ANC)' });
                       }
                   } else if (catName.includes('fitness') || catName.includes('sport')) {
                       specs = [
                           { label: 'Type', value: 'Professional Strength Gear' },
                           { label: 'Material', value: 'Solid Cast Iron & Textured Grip' },
                           { label: 'Usage', value: 'Cardio & Strength Training' },
                           { label: 'Color Accent', value: 'Premium Matte Black' }
                       ];
                       if (product.title.toLowerCase().includes('dumbbell')) {
                           specs.push({ label: 'Adjustment Range', value: 'Adjustable Dial Weight System' });
                       } else if (product.title.toLowerCase().includes('tracker') || product.title.toLowerCase().includes('watch')) {
                           specs.push({ label: 'Heart Rate Monitor', value: 'Precision PPG Sensor' });
                           specs.push({ label: 'Water Protection', value: 'IP68 Swimproof Rating' });
                       }
                   } else if (catName.includes('fashion') || catName.includes('apparel')) {
                       specs = [
                           { label: 'Fabric Composition', value: '100% Organic combed cotton' },
                           { label: 'Fit Profile', value: 'Modern Tailored Comfort Fit' },
                           { label: 'Style Category', value: 'Minimalist Lifestyle wear' },
                           { label: 'Washing Care', value: 'Machine Wash Cold / Air Dry' },
                           { label: 'Sizes', value: 'S, M, L, XL, XXL' }
                       ];
                   } else {
                       specs = [
                           { label: 'Category Unit', value: product.category_name || 'Affiliate Listing' },
                           { label: 'Listing Condition', value: '100% Brand New Boxed' },
                           { label: 'Global Rating', value: '4.8 / 5.0 (Voted Best Value)' },
                           { label: 'Affiliate Partner', value: 'Verified Merchant Link' }
                       ];
                   }
                %>
                
                <div class="absolute -inset-2 md:-inset-4 bg-gradient-to-r from-primary to-secondary rounded-[2.5rem] blur-xl opacity-30 group-hover:opacity-50 transition-opacity duration-700"></div>
                <img id="main-product-image" src="<%= urls[0] %>" alt="<%= product.title %>" crossOrigin="anonymous" class="relative z-20 w-full rounded-[1.5rem] md:rounded-[2rem] shadow-2xl object-contain bg-slate-50 dark:bg-[#412D15]/30 aspect-[4/3] sm:aspect-square cursor-pointer hover:scale-[1.02] transition-transform duration-300 border-4 border-white dark:border-[#412D15]/40">
                <% if (product.badge) { %>
                    <div class="absolute top-4 right-4 sm:top-8 sm:right-8 bg-gradient-to-r from-accent to-pink-500 text-white px-3 py-1 sm:px-5 sm:py-2 rounded-full text-xs sm:text-sm font-bold uppercase tracking-widest shadow-xl shadow-pink-500/40 transform -rotate-2 z-30">
                        <%= product.badge %>
                    </div>
                <% } %>
                
                <% if (urls.length > 1) { %>
                    <div class="flex gap-3 mt-4 overflow-x-auto pb-2 relative z-20 scrollbar-hide px-1">
                        <% urls.forEach((url, i) => { %>
                            <button type="button" class="flex-shrink-0 thumbnail-btn <%= i===0 ? 'ring-2 ring-primary ring-offset-2 scale-105' : 'opacity-70 hover:opacity-100 hover:scale-105' %> rounded-xl overflow-hidden transition-all shadow-md bg-slate-50 dark:bg-[#412D15]/30 dark:ring-offset-[#1F150C]" data-img="<%= url %>">
                                <img src="<%= url %>" class="w-16 h-16 sm:w-20 sm:h-20 object-contain">
                            </button>
                        <% }) %>
                    </div>
                <% } %>
            </div>
            
            <div class="space-y-6 sm:space-y-8 relative px-2 sm:px-0">
                <a href="/category/<%= product.category_slug %>" class="text-xs sm:text-sm text-primary dark:text-[#E1DCC9] font-bold uppercase tracking-widest bg-indigo-50/80 dark:bg-[#412D15]/55 backdrop-blur-sm border border-indigo-100 dark:border-[#412D15]/60 px-3 py-1.5 sm:px-4 sm:py-2 rounded-full inline-block hover:bg-indigo-100 dark:hover:bg-[#412D15]/80 transition-colors">
                    <%= product.category_name %>
                </a>
                
                <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-[#E1DCC9] leading-tight tracking-tight">
                    <%= product.title %>
                </h1>
                
                <div class="space-y-4">
                    <h3 class="text-sm font-bold text-slate-800 dark:text-[#E1DCC9] uppercase tracking-wider">About this item</h3>
                    <div class="space-y-1">
                        <%- formattedDesc %>
                    </div>
                </div>

                <!-- Product Specifications Grid -->
                <% if (specs && specs.length > 0) { %>
                    <div class="pt-6 border-t border-slate-200/60 dark:border-[#412D15]/40 space-y-4">
                        <h3 class="text-sm font-bold text-slate-800 dark:text-[#E1DCC9] uppercase tracking-wider">Product Specifications</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-white/40 dark:bg-[#412D15]/20 p-5 rounded-2xl border border-slate-200/50 dark:border-[#412D15]/30">
                            <% specs.forEach(spec => { %>
                                <div class="border-b border-slate-100/50 dark:border-[#412D15]/10 pb-2">
                                    <span class="block text-[11px] text-slate-400 dark:text-slate-400 uppercase font-medium"><%= spec.label %></span>
                                    <span class="block text-sm text-slate-800 dark:text-[#E1DCC9] font-bold mt-0.5"><%= spec.value %></span>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>
                
                <div class="pt-6 sm:pt-8 border-t border-slate-200/60 dark:border-[#412D15]/40">
                    <div class="flex flex-wrap items-center gap-4 sm:gap-6 mb-8 sm:mb-10">
                        <span class="text-3xl sm:text-4xl font-black text-slate-800 dark:text-white price-display" data-price="<%= product.price %>">$<%= product.price %></span>
                        <% if (product.badge) { %>
                            <span class="bg-indigo-50 dark:bg-[#412D15]/55 text-indigo-700 dark:text-[#E1DCC9] px-3 py-1 sm:px-4 sm:py-1.5 rounded-full text-xs sm:text-sm font-bold"><%= product.badge %></span>
                        <% } %>
                    </div>    
                    <a href="<%= product.affiliate_link %>" target="_blank" rel="noopener noreferrer" class="group relative inline-flex items-center justify-center px-8 py-4 sm:px-10 sm:py-5 text-base sm:text-lg font-bold text-white transition-all duration-300 bg-gray-900 dark:bg-[#412D15] dark:hover:bg-primary rounded-2xl hover:bg-primary focus:outline-none focus:ring-4 focus:ring-primary/50 w-full sm:w-auto shadow-[0_10px_30px_rgba(0,0,0,0.2)] hover:shadow-[0_10px_40px_rgba(79,70,229,0.5)] overflow-hidden border dark:border-[#412D15]/60">
                        <span class="absolute inset-0 w-full h-full -mt-1 rounded-lg opacity-30 bg-gradient-to-b from-transparent via-transparent to-black"></span>
                        <span class="relative flex items-center">
                            <i class="fas fa-shopping-cart mr-3 group-hover:scale-110 transition-transform"></i> Get this Deal
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Lightbox Modal -->
<div id="lightbox" class="fixed inset-0 z-[100] hidden bg-black/95 backdrop-blur-sm items-center justify-center opacity-0 transition-opacity duration-300">
    <button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white transition-colors p-2 z-50">
        <i class="fas fa-times text-3xl"></i>
    </button>
    <img id="lightbox-img" src="" alt="Full size product image" class="max-w-[95%] max-h-[90vh] object-contain rounded-lg shadow-2xl scale-95 transition-transform duration-300">
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const mainImg = document.getElementById('main-product-image');
        const thumbs = document.querySelectorAll('.thumbnail-btn');
        
        // Lightbox elements
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        const lightboxClose = document.getElementById('lightbox-close');
        
        // Open Lightbox
        mainImg.addEventListener('click', () => {
            lightboxImg.src = mainImg.src;
            lightbox.classList.remove('hidden');
            lightbox.classList.add('flex');
            // Trigger animation after tiny delay
            setTimeout(() => {
                lightbox.classList.remove('opacity-0');
                lightboxImg.classList.remove('scale-95');
                lightboxImg.classList.add('scale-100');
            }, 10);
        });
        
        // Close Lightbox function
        const closeLightbox = () => {
            lightbox.classList.add('opacity-0');
            lightboxImg.classList.remove('scale-100');
            lightboxImg.classList.add('scale-95');
            setTimeout(() => {
                lightbox.classList.add('hidden');
                lightbox.classList.remove('flex');
            }, 300);
        };
        
        // Close on button click or background click
        lightboxClose.addEventListener('click', closeLightbox);
        lightbox.addEventListener('click', (e) => {
            if (e.target === lightbox) closeLightbox();
        });
        // Close on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) {
                closeLightbox();
            }
        });
        
        // Color sync for navigation bar background
        function updateNavBarColor(imgElement) {
            const navBar = document.getElementById('main-nav-bar');
            const accentLine = document.getElementById('nav-accent-line');
            if (!navBar || !accentLine || !imgElement) return;

            function getAverageColor(img) {
                try {
                    const canvas = document.createElement('canvas');
                    const ctx = canvas.getContext('2d');
                    canvas.width = 5;
                    canvas.height = 5;
                    img.crossOrigin = "anonymous";
                    ctx.drawImage(img, 0, 0, 5, 5);
                    const imgData = ctx.getImageData(0, 0, 5, 5).data;
                    
                    let r = 0, g = 0, b = 0, count = 0;
                    for (let i = 0; i < imgData.length; i += 4) {
                        const total = imgData[i] + imgData[i+1] + imgData[i+2];
                        if (total > 50 && total < 720) {
                            r += imgData[i];
                            g += imgData[i+1];
                            b += imgData[i+2];
                            count++;
                        }
                    }
                    if (count === 0) {
                        for (let i = 0; i < imgData.length; i += 4) {
                            r += imgData[i];
                            g += imgData[i+1];
                            b += imgData[i+2];
                            count++;
                        }
                    }
                    r = Math.floor(r / count);
                    g = Math.floor(g / count);
                    b = Math.floor(b / count);
                    
                    // Boost saturation
                    const max = Math.max(r, g, b);
                    const min = Math.min(r, g, b);
                    const delta = (max - min) / 255;
                    if (delta < 0.2) {
                        r = Math.min(255, Math.floor(r * 1.1 + 20));
                        g = Math.min(255, Math.floor(g * 1.0));
                        b = Math.min(255, Math.floor(b * 1.2 + 20));
                    }
                    return { r, g, b };
                } catch (e) {
                    return null;
                }
            }

            function applyColor(colors) {
                if (!colors) {
                    accentLine.style.background = '';
                    navBar.style.borderColor = '';
                    navBar.style.backgroundColor = '';
                    return;
                }
                const { r, g, b } = colors;
                accentLine.style.background = `rgb(${r}, ${g}, ${b})`;
                navBar.style.borderColor = `rgba(${r}, ${g}, ${b}, 0.25)`;
                
                const isDark = document.documentElement.classList.contains('dark');
                if (isDark) {
                    const mixR = Math.floor(r * 0.25 + 31 * 0.75);
                    const mixG = Math.floor(g * 0.25 + 21 * 0.75);
                    const mixB = Math.floor(b * 0.25 + 12 * 0.75);
                    navBar.style.backgroundColor = `rgba(${mixR}, ${mixG}, ${mixB}, 0.9)`;
                } else {
                    const mixR = Math.floor(r * 0.25 + 240 * 0.75);
                    const mixG = Math.floor(g * 0.25 + 244 * 0.75);
                    const mixB = Math.floor(b * 0.25 + 248 * 0.75);
                    navBar.style.backgroundColor = `rgba(${mixR}, ${mixG}, ${mixB}, 0.85)`;
                }
            }

            if (imgElement.complete && imgElement.naturalHeight !== 0) {
                applyColor(getAverageColor(imgElement));
            } else {
                imgElement.addEventListener('load', () => {
                    applyColor(getAverageColor(imgElement));
                }, { once: true });
            }
        }

        // Initialize nav color on product detail page load
        if (mainImg) {
            updateNavBarColor(mainImg);
        }

        // Thumbnail functionality
        thumbs.forEach(btn => {
            btn.addEventListener('click', () => {
                // Update main image src
                mainImg.src = btn.getAttribute('data-img');
                
                // Update styling
                thumbs.forEach(t => {
                    t.classList.remove('ring-2', 'ring-primary', 'ring-offset-2', 'scale-105');
                    t.classList.add('opacity-70', 'hover:opacity-100', 'hover:scale-105');
                });
                btn.classList.add('ring-2', 'ring-primary', 'ring-offset-2', 'scale-105');
                btn.classList.remove('opacity-70', 'hover:opacity-100', 'hover:scale-105');

                // Recalculate and transition nav color to matches thumbnail image
                setTimeout(() => {
                    updateNavBarColor(mainImg);
                }, 50);
            });
        });
    });
</script>

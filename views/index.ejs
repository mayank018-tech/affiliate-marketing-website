<!-- Hero Slideshow Section -->
<section class="relative w-full overflow-hidden bg-slate-50 dark:bg-[#1F150C] pt-6 pb-10 border-b border-slate-100 dark:border-[#412D15]/40 transition-colors duration-300">
    <% if (typeof slideshowProducts !== 'undefined' && slideshowProducts.length > 0) { %>
        <!-- Slideshow Wrapper -->
        <div id="hero-slideshow" class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-[480px] sm:h-[380px] md:h-[380px] lg:h-[390px] xl:h-[410px] rounded-3xl overflow-hidden group">
            
            <!-- Slides Container -->
            <div class="relative w-full h-full">
                <% slideshowProducts.forEach((product, index) => { %>
                    <div class="slide absolute inset-0 w-full h-full opacity-0 pointer-events-none transition-all duration-700 ease-in-out flex items-center <%= index === 0 ? 'opacity-100 pointer-events-auto z-10' : '' %>" data-index="<%= index %>">
                        <!-- Blurred Background Image for depth -->
                        <div class="absolute inset-0 bg-cover bg-center filter blur-3xl opacity-10 dark:opacity-20 scale-105" style="background-image: url('<%= product.cover_image %>');"></div>
                        <!-- Subtle overlay gradient -->
                        <div class="absolute inset-0 bg-gradient-to-b lg:bg-gradient-to-r from-slate-50 via-slate-50/80 to-transparent dark:from-[#1F150C] dark:via-[#1F150C]/90 dark:to-transparent"></div>
                        
                        <!-- Slide Content Grid -->
                        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-8 items-center justify-center w-full h-full px-4 sm:px-8 md:px-12 py-4">
                            
                            <!-- Product Image Showcase -->
                            <div class="order-1 lg:order-2 lg:col-span-5 flex justify-center relative">
                                <div class="absolute inset-0 bg-gradient-to-tr from-primary/20 to-secondary/20 dark:from-primary/15 dark:to-secondary/15 rounded-3xl blur-2xl animate-pulse-slow"></div>
                                <div class="relative glass-card p-2 rounded-3xl border border-white/20 shadow-xl hover:scale-[1.01] transition-transform duration-500">
                                    <img src="<%= product.cover_image %>" alt="<%= product.title %>" crossOrigin="anonymous" class="slideshow-image w-[120px] h-[120px] sm:w-[170px] sm:h-[170px] md:w-[200px] md:h-[200px] lg:w-[260px] lg:h-[260px] xl:w-[280px] xl:h-[280px] object-cover rounded-2xl shadow-md">
                                </div>
                            </div>

                            <!-- Product Details -->
                            <div class="order-2 lg:order-1 lg:col-span-7 space-y-3 lg:space-y-4 text-slate-900 dark:text-[#E1DCC9] text-center lg:text-left flex flex-col items-center lg:items-start">
                                <% if (product.badge) { %>
                                    <span class="inline-block bg-gradient-to-r from-accent to-pink-500 text-white px-3 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider shadow-md shadow-pink-500/20">
                                        <%= product.badge %>
                                    </span>
                                <% } %>
                                
                                <div class="space-y-1">
                                    <span class="text-[10px] sm:text-xs font-bold text-secondary dark:text-indigo-400 tracking-widest uppercase block"><%= product.category_name %></span>
                                    <h2 class="text-lg sm:text-xl md:text-2xl lg:text-4xl font-extrabold tracking-tight leading-snug line-clamp-1">
                                        <%= product.title %>
                                    </h2>
                                </div>
                                
                                <p class="text-slate-650 dark:text-slate-300 text-xs sm:text-sm leading-relaxed line-clamp-2 md:line-clamp-3 max-w-xl">
                                    <%= product.description %>
                                </p>
                                
                                <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-6 pt-1 lg:pt-3 w-full sm:w-auto">
                                    <div class="flex flex-col text-center sm:text-left">
                                        <span class="text-[9px] sm:text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-wider">Best Deal</span>
                                        <span class="text-xl sm:text-2xl md:text-3xl font-extrabold text-slate-900 dark:text-white price-display" data-price="<%= product.price %>">$<%= product.price %></span>
                                    </div>
                                    <div class="flex gap-2.5 w-full sm:w-auto justify-center sm:justify-start">
                                        <a href="/product/<%= product.slug %>" class="bg-slate-200/60 hover:bg-slate-200 dark:bg-white/10 dark:hover:bg-white/20 text-slate-800 dark:text-[#E1DCC9] px-4 sm:px-6 py-2 rounded-full font-bold border border-slate-350/50 dark:border-white/10 backdrop-blur-md transition-all duration-300 text-center text-xs flex-1 sm:flex-none">
                                            Details
                                        </a>
                                        <a href="<%= product.affiliate_link %>" target="_blank" rel="noopener noreferrer" class="bg-gradient-to-r from-primary to-secondary hover:from-indigo-600 hover:to-violet-700 text-white px-4 sm:px-6 py-2 rounded-full font-bold shadow-md shadow-primary/20 transition-all duration-300 flex items-center justify-center text-xs flex-1 sm:flex-none">
                                            <i class="fas fa-shopping-cart mr-1.5"></i> Get Deal
                                        </a>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                <% }) %>
            </div>

            <!-- Navigation Controls -->
            <button id="prev-slide" class="hidden md:flex absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/60 hover:bg-slate-900 border border-white/10 hover:border-white/20 text-white items-center justify-center backdrop-blur-md opacity-0 group-hover:opacity-100 transition-all duration-300 z-20 cursor-pointer shadow-md hover:scale-105">
                <i class="fas fa-chevron-left text-sm"></i>
            </button>
            <button id="next-slide" class="hidden md:flex absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/60 hover:bg-slate-900 border border-white/10 hover:border-white/20 text-white items-center justify-center backdrop-blur-md opacity-0 group-hover:opacity-100 transition-all duration-300 z-20 cursor-pointer shadow-md hover:scale-105">
                <i class="fas fa-chevron-right text-sm"></i>
            </button>

            <!-- Slide Indicators/Dots -->
            <div class="absolute bottom-3 sm:bottom-4 left-1/2 -translate-x-1/2 flex items-center gap-1.5 z-20">
                <% slideshowProducts.forEach((_, index) => { %>
                    <button class="slide-dot w-2 h-2 sm:w-2 sm:h-2 rounded-full bg-slate-400/50 dark:bg-[#E1DCC9]/30 hover:bg-slate-400 dark:hover:bg-[#E1DCC9]/60 transition-all duration-300 cursor-pointer <%= index === 0 ? 'bg-slate-900 dark:bg-[#E1DCC9] w-5' : '' %>" data-index="<%= index %>"></button>
                <% }) %>
            </div>

        </div>
        
        <!-- JavaScript for Slideshow logic -->
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const slides = document.querySelectorAll('#hero-slideshow .slide');
                const dots = document.querySelectorAll('#hero-slideshow .slide-dot');
                const prevBtn = document.getElementById('prev-slide');
                const nextBtn = document.getElementById('next-slide');
                const container = document.getElementById('hero-slideshow');
                
                let currentSlide = 0;
                let slideInterval;
                const intervalTime = 5000;
                
                function updateNavBarColor(imgElement) {
                    const navBar = document.getElementById('main-nav-bar');
                    const accentLine = document.getElementById('nav-accent-line');
                    if (!navBar || !accentLine || !imgElement) return;

                    function getAverageColor(img) {
                        try {
                            const canvas = document.createElement('canvas');
                            const ctx = canvas.getContext('2d');
                            canvas.width = 5;
                            canvas.height = 5;
                            // Set crossOrigin via JS just in case, though it is on the element
                            img.crossOrigin = "anonymous";
                            ctx.drawImage(img, 0, 0, 5, 5);
                            const imgData = ctx.getImageData(0, 0, 5, 5).data;
                            
                            let r = 0, g = 0, b = 0, count = 0;
                            for (let i = 0; i < imgData.length; i += 4) {
                                // Exclude extremely light/dark pixels to find pure colors
                                const total = imgData[i] + imgData[i+1] + imgData[i+2];
                                if (total > 50 && total < 720) {
                                    r += imgData[i];
                                    g += imgData[i+1];
                                    b += imgData[i+2];
                                    count++;
                                }
                            }
                            
                            if (count === 0) {
                                for (let i = 0; i < imgData.length; i += 4) {
                                    r += imgData[i];
                                    g += imgData[i+1];
                                    b += imgData[i+2];
                                    count++;
                                }
                            }
                            
                            r = Math.floor(r / count);
                            g = Math.floor(g / count);
                            b = Math.floor(b / count);
                            
                            // Boost saturation to make it a vibrant accent color
                            const max = Math.max(r, g, b);
                            const min = Math.min(r, g, b);
                            const delta = (max - min) / 255;
                            if (delta < 0.2) {
                                // If the image is very grayscale, make it more vibrant by shifting to primary colors
                                r = Math.min(255, Math.floor(r * 1.1 + 20));
                                g = Math.min(255, Math.floor(g * 1.0));
                                b = Math.min(255, Math.floor(b * 1.2 + 20));
                            }
                            
                            return { r, g, b };
                        } catch (e) {
                            console.warn("Unable to extract image color due to CORS limitations:", e);
                            return null;
                        }
                    }

                    function applyColor(colors) {
                        const navLinks = document.querySelectorAll('.nav-menu-link');
                        if (!colors) {
                            accentLine.style.background = '';
                            navBar.style.borderColor = '';
                            navBar.style.backgroundColor = '';
                            navLinks.forEach(link => {
                                link.style.setProperty('--hover-color', '');
                                link.style.color = '';
                            });
                            return;
                        }
                        const { r, g, b } = colors;
                        accentLine.style.background = `rgb(${r}, ${g}, ${b})`;
                        navBar.style.borderColor = `rgba(${r}, ${g}, ${b}, 0.25)`;
                        
                        const isDark = document.documentElement.classList.contains('dark');
                        if (isDark) {
                            navBar.style.backgroundColor = `rgba(31, 21, 12, 0.85)`;
                        } else {
                            navBar.style.backgroundColor = `rgba(${r}, ${g}, ${b}, 0.08)`;
                        }

                        // Apply color dynamic state to nav links (Home, Categories, Trending)
                        navLinks.forEach(link => {
                            link.style.setProperty('--hover-color', `rgb(${r}, ${g}, ${b})`);
                            // Since this is homepage, Home is active unless they scroll or navigate
                            const isHome = link.getAttribute('href') === '/';
                            if (isHome) {
                                link.style.color = `rgb(${r}, ${g}, ${b})`;
                            } else {
                                link.style.color = '';
                            }
                        });
                    }

                    if (imgElement.complete && imgElement.naturalHeight !== 0) {
                        applyColor(getAverageColor(imgElement));
                    } else {
                        imgElement.addEventListener('load', () => {
                            applyColor(getAverageColor(imgElement));
                        }, { once: true });
                    }
                }

                function showSlide(index) {
                    if (slides.length === 0) return;
                    
                    slides.forEach(slide => {
                        slide.classList.remove('opacity-100', 'pointer-events-auto', 'z-10');
                        slide.classList.add('opacity-0', 'pointer-events-none');
                    });
                    dots.forEach(dot => {
                        dot.classList.remove('bg-slate-900', 'bg-[#E1DCC9]', 'w-5', 'w-6');
                        dot.classList.add('bg-slate-400/50', 'dark:bg-[#E1DCC9]/30');
                    });
                    
                    currentSlide = (index + slides.length) % slides.length;
                    
                    slides[currentSlide].classList.remove('opacity-0', 'pointer-events-none');
                    slides[currentSlide].classList.add('opacity-100', 'pointer-events-auto', 'z-10');
                    
                    const activeDot = dots[currentSlide];
                    activeDot.classList.remove('bg-slate-400/50', 'dark:bg-[#E1DCC9]/30');
                    if (document.documentElement.classList.contains('dark')) {
                        activeDot.classList.add('bg-[#E1DCC9]', 'w-5');
                    } else {
                        activeDot.classList.add('bg-slate-900', 'w-5');
                    }

                    // Dynamically update menu bar color based on active product cover image
                    const activeImg = slides[currentSlide].querySelector('.slideshow-image');
                    if (activeImg) {
                        updateNavBarColor(activeImg);
                    }
                }

                // Initial run for the first slide on page load
                const firstImg = slides[0]?.querySelector('.slideshow-image');
                if (firstImg) {
                    updateNavBarColor(firstImg);
                }
                
                function nextSlide() {
                    showSlide(currentSlide + 1);
                }
                
                window.nextSlide = nextSlide;
                
                function prevSlide() {
                    showSlide(currentSlide - 1);
                }
                
                function startAutoPlay() {
                    stopAutoPlay();
                    slideInterval = setInterval(nextSlide, intervalTime);
                }
                
                function stopAutoPlay() {
                    if (slideInterval) {
                        clearInterval(slideInterval);
                    }
                }
                
                if (nextBtn) nextBtn.addEventListener('click', () => {
                    nextSlide();
                    startAutoPlay();
                });
                
                if (prevBtn) prevBtn.addEventListener('click', () => {
                    prevSlide();
                    startAutoPlay();
                });
                
                dots.forEach(dot => {
                    dot.addEventListener('click', (e) => {
                        const idx = parseInt(e.target.getAttribute('data-index'));
                        showSlide(idx);
                        startAutoPlay();
                    });
                });
                
                if (container) {
                    container.addEventListener('mouseenter', stopAutoPlay);
                    container.addEventListener('mouseleave', startAutoPlay);
                }
                
                // --- Mobile Touch Swipe Support ---
                let touchStartX = 0;
                let touchEndX = 0;
                
                if (container) {
                    container.addEventListener('touchstart', (e) => {
                        touchStartX = e.changedTouches[0].screenX;
                    }, { passive: true });
                    
                    container.addEventListener('touchend', (e) => {
                        touchEndX = e.changedTouches[0].screenX;
                        handleSwipe();
                    }, { passive: true });
                }
                
                function handleSwipe() {
                    const threshold = 55; // swipe distance threshold
                    const swipeDistance = touchEndX - touchStartX;
                    
                    if (Math.abs(swipeDistance) > threshold) {
                        if (swipeDistance < 0) {
                            nextSlide();
                        } else {
                            prevSlide();
                        }
                        startAutoPlay();
                    }
                }

                const observer = new MutationObserver(() => {
                    showSlide(currentSlide);
                });
                observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
                
                startAutoPlay();
            });
        </script>
    <% } else { %>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-[300px] flex items-center justify-center text-center">
            <div class="space-y-4">
                <h1 class="text-4xl font-bold text-slate-800 dark:text-[#E1DCC9] leading-tight">
                    Discover Amazing <span class="bg-gradient-to-r from-accent to-secondary bg-clip-text text-transparent">Products</span>
                </h1>
                <p class="text-base text-slate-600 dark:text-slate-350 max-w-xl mx-auto">
                    Browse and shop premium affiliate products across multiple categories.
                </p>
            </div>
        </div>
    <% } %>
</section>

<!-- Categories Grid -->
<section id="categories" class="py-16 bg-white dark:bg-[#1F150C] transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-gray-900 dark:text-[#E1DCC9] mb-4">Browse Categories</h2>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            <% categories.forEach(category => { %>
                <a href="/category/<%= category.slug %>" class="category-badge glass-card p-6 rounded-3xl block hover:bg-white/60 dark:hover:bg-[#412D15]/40 transition-all duration-300 group cursor-pointer relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-secondary/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    <div class="relative z-10">
                        <div class="w-14 h-14 bg-gradient-to-br from-[#412D15] to-[#7c3aed] dark:from-[#E1DCC9] dark:to-[#412D15] rounded-2xl flex items-center justify-center mb-5 shadow-lg shadow-primary/20 group-hover:scale-110 transition-transform duration-300">
                            <i class="<%= category.icon %> text-white dark:text-[#1F150C] text-2xl"></i>
                        </div>
                        <h3 class="font-bold text-gray-900 dark:text-[#E1DCC9] text-lg group-hover:text-primary dark:group-hover:text-[#E1DCC9] transition-colors"><%= category.name %></h3>
                    </div>
                </a>
            <% }) %>
        </div>
    </div>
</section>

<!-- Trending Products -->
<section id="trending" class="py-16 bg-gray-50 dark:bg-[#000000]/25 border-t border-gray-100 dark:border-[#412D15]/40 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <h2 class="text-3xl font-bold text-gray-900 dark:text-[#E1DCC9] mb-2">Trending Products</h2>
        </div>
        
        <div class="product-grid mt-10">
            <% products.forEach(product => { %>
                <div class="product-card glass-card rounded-3xl overflow-hidden hover:bg-white/80 dark:hover:bg-[#412D15]/45 transition-all duration-500 border border-white/50 dark:border-[#412D15]/40 group relative">
                    <a href="/product/<%= product.slug %>" class="relative block overflow-hidden">
                        <img src="<%= product.cover_image %>" alt="<%= product.title %>" loading="lazy" class="w-full h-56 object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out">
                        <% if (product.badge) { %>
                            <div class="absolute top-4 right-4 bg-gradient-to-r from-accent to-pink-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider shadow-lg shadow-pink-500/30">
                                <%= product.badge %>
                            </div>
                        <% } %>
                    </a>
                    <div class="p-8">
                        <a href="/category/<%= product.category_slug %>" class="text-xs text-secondary dark:text-indigo-400 font-bold uppercase tracking-widest mb-3 inline-block hover:text-primary dark:hover:text-[#E1DCC9] transition-colors">
                            <%= product.category_name %>
                        </a>
                        <a href="/product/<%= product.slug %>">
                            <h3 class="font-bold text-gray-900 dark:text-[#E1DCC9] text-xl mb-3 hover:text-primary dark:hover:text-[#E1DCC9] transition-colors line-clamp-1"><%= product.title %></h3>
                        </a>
                        <p class="text-gray-500 dark:text-slate-350 text-sm mb-6 line-clamp-2 leading-relaxed"><%= product.description %></p>
                        <div class="flex justify-between items-center mt-auto">
                            <span class="text-3xl font-extrabold text-slate-800 dark:text-[#E1DCC9] price-display" data-price="<%= product.price %>">$<%= product.price %></span>
                            <a href="<%= product.affiliate_link %>" target="_blank" rel="noopener noreferrer" class="bg-gray-900 dark:bg-[#412D15] text-white dark:text-[#E1DCC9] px-5 py-2.5 rounded-xl hover:bg-primary dark:hover:bg-primary hover:shadow-[0_0_15px_rgba(79,70,229,0.5)] transition-all duration-300 font-medium flex items-center border dark:border-[#412D15]/50">
                                <i class="fas fa-shopping-cart mr-2 text-sm"></i> Deal
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</section>

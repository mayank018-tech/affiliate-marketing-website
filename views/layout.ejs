<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' | NexusAffiliate' : 'NexusAffiliate' %></title>
    <!-- Premium Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        // Check local storage or system preference and apply dark theme immediately
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }

        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Outfit', 'sans-serif'],
                        body: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: '#4f46e5', // deeper indigo
                        secondary: '#7c3aed', // richer violet
                        accent: '#ec4899',
                        dark: '#1F150C',
                        huntBlack: '#000000',
                        huntDark: '#1F150C',
                        huntMedium: '#412D15',
                        huntLight: '#E1DCC9',
                        light: '#f8fafc'
                    },
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'slide-in': 'slideIn 0.5s ease-out forwards'
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-20px)' }
                        },
                        slideIn: {
                            '0%': { opacity: 0, transform: 'translateY(20px)' },
                            '100%': { opacity: 1, transform: 'translateY(0)' }
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        h1, h2, h3, h4, h5, h6, .font-bold, .font-semibold { font-family: 'Outfit', sans-serif; }
        
        .glass-card {
            backdrop-filter: blur(20px) saturate(200%);
            -webkit-backdrop-filter: blur(20px) saturate(200%);
            background-color: rgba(255, 255, 255, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
            transition: background-color 0.3s, border-color 0.3s, box-shadow 0.3s;
        }
        .dark .glass-card {
            background-color: rgba(65, 45, 21, 0.45);
            border: 1px solid rgba(225, 220, 201, 0.08);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);
        }
        .gradient-bg {
            background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
        }
        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 2rem;
        }
        .category-badge:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
        }
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }
        .search-bar:focus-within {
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.3);
        }
    </style>
</head>
<body class="bg-[#f0f4f8] text-slate-800 dark:bg-[#1F150C] dark:text-[#E1DCC9] min-h-screen flex flex-col transition-colors duration-300">
    <!-- Navigation -->
    <nav class="fixed top-0 w-full bg-[#f0f4f8]/80 dark:bg-[#1F150C]/80 backdrop-blur-xl z-50 border-b border-slate-200/50 dark:border-[#412D15]/30 shadow-sm transition-all duration-300">
        <!-- Premium thin gradient line at the top -->
        <div class="h-[3px] w-full bg-gradient-to-r from-primary to-secondary"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <a href="/" class="flex items-center space-x-2.5">
                    <div class="w-8 h-8 bg-gradient-to-r from-[#412D15] to-[#7c3aed] dark:from-[#E1DCC9] dark:to-white rounded-xl flex items-center justify-center shadow-md">
                        <i class="fas fa-shopping-bag text-white dark:text-[#1F150C] text-sm"></i>
                    </div>
                    <span class="text-xl font-extrabold bg-gradient-to-r from-primary to-secondary dark:from-[#E1DCC9] dark:to-white bg-clip-text text-transparent tracking-tight">NexusAffiliate</span>
                </a>
                
                <div class="hidden md:flex items-center space-x-8">
                    <a href="/" class="text-slate-600 dark:text-[#E1DCC9] hover:text-indigo-650 dark:hover:text-white font-medium transition-colors">Home</a>
                    <a href="/#categories" class="text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 font-medium transition-colors">Categories</a>
                    <a href="/#trending" class="text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 font-medium transition-colors">Trending</a>
                </div>
                
                <div class="hidden md:flex items-center space-x-4">
                    <!-- Currency Selector -->
                    <div class="relative">
                        <select id="currency-selector" class="bg-white/10 dark:bg-[#412D15]/45 text-slate-700 dark:text-[#E1DCC9] px-3 py-1 rounded border border-slate-200 dark:border-[#412D15]/50 outline-none focus:border-primary">
                            <option value="INR">INR (₹)</option>
                            <option value="USD">USD ($)</option>
                            <option value="EUR">EUR (€)</option>
                            <option value="GBP">GBP (£)</option>
                            <option value="CAD">CAD ($)</option>
                            <option value="AUD">AUD ($)</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-indigo-700 dark:text-[#E1DCC9]">
                            <i class="fas fa-chevron-down text-xs"></i>
                        </div>
                    </div>
                    <!-- Theme Toggle -->
                    <button id="theme-toggle" class="text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none" aria-label="Toggle Theme">
                        <i id="theme-toggle-icon" class="fas fa-moon text-lg"></i>
                    </button>


                    <% if (user && user.role === 'admin') { %>
                        <a href="/admin" class="text-indigo-600 font-bold hover:text-indigo-800 transition-colors ml-4">Dashboard</a>
                        <a href="/admin/logout" class="bg-gray-200 text-gray-700 px-4 py-2 rounded-full hover:bg-gray-300 transition-colors whitespace-nowrap">
                            Logout
                        </a>
                    <% } else { %>
                        <a href="/admin/login" class="bg-primary text-white px-4 py-2 rounded-full hover:bg-indigo-600 transition-colors whitespace-nowrap">
                            <i class="fas fa-user mr-2"></i> Admin
                        </a>
                    <% } %>
                </div>

                <!-- Mobile menu button -->
                <div class="md:hidden flex items-center space-x-2">
                    <!-- Mobile Topbar Theme Toggle -->
                    <button id="mobile-top-theme-toggle" class="text-slate-600 dark:text-[#E1DCC9] p-2 hover:bg-slate-100 dark:hover:bg-[#412D15]/50 rounded-full transition-colors focus:outline-none" aria-label="Toggle Theme">
                        <i id="mobile-top-theme-toggle-icon" class="fas fa-moon text-lg"></i>
                    </button>
                    
                    <button id="mobile-menu-btn" class="text-slate-600 dark:text-[#E1DCC9] hover:text-indigo-600 focus:outline-none p-2">
                        <i class="fas fa-bars text-2xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Panel -->
        <div id="mobile-menu" class="hidden md:hidden bg-white dark:bg-[#1F150C] border-t border-slate-100 dark:border-[#412D15]/40 shadow-lg absolute w-full transition-all duration-300">
            <div class="px-4 pt-2 pb-4 space-y-3 flex flex-col">
                <a href="/" class="block px-3 py-2 text-slate-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-[#412D15]/50 hover:text-indigo-600 dark:hover:text-[#E1DCC9] rounded-md font-medium">Home</a>
                <a href="/#categories" class="block px-3 py-2 text-slate-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-950/40 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-md font-medium">Categories</a>
                <a href="/#trending" class="block px-3 py-2 text-slate-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-950/40 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-md font-medium">Trending</a>
                
                <div class="px-3 py-2 border-t border-slate-100 dark:border-slate-800 mt-2">
                    <label class="block text-sm text-slate-500 mb-1">Currency</label>
                    <select id="mobile-currency-selector" class="w-full bg-slate-50 dark:bg-[#412D15]/45 text-slate-700 dark:text-[#E1DCC9] px-3 py-2 rounded border border-slate-200 dark:border-[#412D15]/50 outline-none">
                        <option value="INR">INR (₹)</option>
                        <option value="USD">USD ($)</option>
                        <option value="EUR">EUR (€)</option>
                        <option value="GBP">GBP (£)</option>
                        <option value="CAD">CAD ($)</option>
                        <option value="AUD">AUD ($)</option>
                    </select>
                </div>

                <div class="px-3 py-2 border-t border-slate-100 dark:border-slate-800 mt-2 flex justify-between items-center">
                    <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Dark Mode</span>
                    <button id="mobile-theme-toggle" class="text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none">
                        <i id="mobile-theme-toggle-icon" class="fas fa-moon text-lg"></i>
                    </button>
                </div>
                
                <div class="px-3 py-2 border-t border-slate-100 dark:border-slate-800 mt-2 flex flex-col gap-2">
                    <% if (user && user.role === 'admin') { %>
                        <a href="/admin" class="w-full text-center bg-indigo-50 text-indigo-700 font-bold px-4 py-2 rounded-lg">Dashboard</a>
                        <a href="/admin/logout" class="w-full text-center bg-red-50 dark:bg-red-950/40 text-red-650 dark:text-red-400 font-bold px-4 py-2 rounded-lg">Logout</a>
                    <% } else { %>
                        <a href="/admin/login" class="w-full text-center bg-primary text-white font-bold px-4 py-2 rounded-lg">Admin Login</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <script>
        // Mobile Menu Toggle
        document.addEventListener('DOMContentLoaded', () => {
            const btn = document.getElementById('mobile-menu-btn');
            const menu = document.getElementById('mobile-menu');
            if(btn && menu) {
                btn.addEventListener('click', () => {
                    menu.classList.toggle('hidden');
                });
            }
            
            

            // Dark Mode Toggle Logic
            const themeToggleBtn = document.getElementById('theme-toggle');
            const themeToggleIcon = document.getElementById('theme-toggle-icon');
            const mobileThemeToggleBtn = document.getElementById('mobile-theme-toggle');
            const mobileThemeToggleIcon = document.getElementById('mobile-theme-toggle-icon');
            const mobileTopThemeToggleBtn = document.getElementById('mobile-top-theme-toggle');
            const mobileTopThemeToggleIcon = document.getElementById('mobile-top-theme-toggle-icon');

            function updateToggleIcons(isDark) {
                if (isDark) {
                    [themeToggleIcon, mobileThemeToggleIcon, mobileTopThemeToggleIcon].forEach(icon => {
                        if (icon) {
                            icon.classList.remove('fa-moon');
                            icon.classList.add('fa-sun');
                        }
                    });
                } else {
                    [themeToggleIcon, mobileThemeToggleIcon, mobileTopThemeToggleIcon].forEach(icon => {
                        if (icon) {
                            icon.classList.remove('fa-sun');
                            icon.classList.add('fa-moon');
                        }
                    });
                }
            }

            const isInitiallyDark = document.documentElement.classList.contains('dark');
            updateToggleIcons(isInitiallyDark);

            function toggleTheme() {
                const isDark = document.documentElement.classList.toggle('dark');
                localStorage.setItem('theme', isDark ? 'dark' : 'light');
                updateToggleIcons(isDark);
            }

            if (themeToggleBtn) {
                themeToggleBtn.addEventListener('click', toggleTheme);
            }
            if (mobileThemeToggleBtn) {
                mobileThemeToggleBtn.addEventListener('click', toggleTheme);
            }
            if (mobileTopThemeToggleBtn) {
                mobileTopThemeToggleBtn.addEventListener('click', toggleTheme);
            }

            // Sync mobile currency selector with desktop
            const mobileCurrency = document.getElementById('mobile-currency-selector');
            const desktopCurrency = document.getElementById('currency-selector');
            if(mobileCurrency && desktopCurrency) {
                mobileCurrency.value = desktopCurrency.value || 'INR';
                mobileCurrency.addEventListener('change', (e) => {
                    desktopCurrency.value = e.target.value;
                    desktopCurrency.dispatchEvent(new Event('change'));
                });
                
                // Add event listener to update mobile when desktop changes
                desktopCurrency.addEventListener('change', (e) => {
                    mobileCurrency.value = e.target.value;
                });
            }
        });
    </script>

    <main class="flex-grow pt-16">
        <%- body %>
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-white py-12 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="border-t border-slate-800 pt-8 text-center text-slate-400">
                <p>&copy; <%= new Date().getFullYear() %> NexusAffiliate. All rights reserved. Built with ❤️ for modern shoppers.</p>
            </div>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Existing Intersection Observer
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.animation = 'slideIn 0.6s ease-out forwards';
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.category-badge, .product-card').forEach(el => {
                observer.observe(el);
            });

            // Currency Converter Logic
            const currencySelector = document.getElementById('currency-selector');
            const priceElements = document.querySelectorAll('.price-display');
            
            const currencySymbols = {
                'USD': '$',
                'EUR': '€',
                'GBP': '£',
                'INR': '₹',
                'CAD': 'CA$',
                'AUD': 'AU$'
            };

            let rates = null;
            let currentCurrency = localStorage.getItem('selectedCurrency') || 'INR';
            
            if (currencySelector) {
                currencySelector.value = currentCurrency;
            }

            async function fetchRates() {
                try {
                    const response = await fetch('https://open.er-api.com/v6/latest/INR');
                    const data = await response.json();
                    rates = data.rates;
                    updatePrices(currentCurrency);
                } catch (error) {
                    console.error('Error fetching exchange rates:', error);
                }
            }

            function updatePrices(currency) {
                if (!rates) return;
                const rate = rates[currency] || 1;
                const symbol = currencySymbols[currency] || '$';

                priceElements.forEach(el => {
                    const basePrice = parseFloat(el.getAttribute('data-price'));
                    if (!isNaN(basePrice)) {
                        const converted = (basePrice * rate).toFixed(2);
                        // Optional: Format numbers for locales (like Indian Rupee system)
                        const formatted = new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(converted);
                        el.textContent = `${symbol}${formatted}`;
                    }
                });
            }

            if (currencySelector) {
                currencySelector.addEventListener('change', (e) => {
                    currentCurrency = e.target.value;
                    localStorage.setItem('selectedCurrency', currentCurrency);
                    updatePrices(currentCurrency);
                });
            }

            // Initial fetch
            fetchRates();
        });
    </script>
</body>
</html>

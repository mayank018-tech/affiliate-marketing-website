<!-- Category Products -->
<section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center space-x-4 mb-8">
            <div class="w-16 h-16 bg-gradient-to-r from-primary to-secondary rounded-2xl flex items-center justify-center">
                <i class="<%= category.icon %> text-white text-2xl"></i>
            </div>
            <h1 class="text-4xl font-bold text-gray-900"><%= category.name %></h1>
        </div>
        
        <% if (products.length === 0) { %>
            <p class="text-gray-600">No products found in this category.</p>
        <% } else { %>
            <div class="product-grid">
                <% products.forEach(product => { %>
                    <div class="product-card glass-card rounded-2xl overflow-hidden hover:bg-white transition-all border border-gray-200 bg-white">
                        <a href="/product/<%= product.slug %>" class="relative block">
                            <img src="<%= product.cover_image %>" alt="<%= product.title %>" class="w-full h-48 object-cover">
                            <% if (product.badge) { %>
                                <div class="absolute top-4 right-4 bg-accent text-white px-2 py-1 rounded-full text-xs font-medium">
                                    <%= product.badge %>
                                </div>
                            <% } %>
                        </a>
                        <div class="p-6">
                            <a href="/product/<%= product.slug %>">
                                <h3 class="font-semibold text-gray-900 mb-2 hover:text-primary transition-colors"><%= product.title %></h3>
                            </a>
                            <p class="text-gray-600 text-sm mb-4 line-clamp-2"><%= product.description %></p>
                            <div class="flex justify-between items-center mt-auto">
                                <span class="text-3xl font-extrabold text-slate-800 price-display" data-price="<%= product.price %>">$<%= product.price %></span>
                                <a href="<%= product.affiliate_link %>" target="_blank" rel="noopener noreferrer" class="bg-primary text-white px-5 py-2.5 rounded-xl hover:shadow-lg transition-all duration-300 font-medium flex items-center">
                                    <i class="fas fa-shopping-cart mr-2 text-sm"></i> Deal
                                </a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</section>

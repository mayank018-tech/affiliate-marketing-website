<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex items-center justify-between">
        <div class="flex items-center space-x-4">
            <a href="/admin" class="text-slate-500 hover:text-indigo-600 transition-colors bg-white w-10 h-10 rounded-full flex items-center justify-center shadow-sm">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h1 class="text-3xl font-bold text-slate-800 font-['Outfit']"><%= title %></h1>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 overflow-hidden">
        <form action="<%= category.id ? '/admin/categories/' + category.id : '/admin/categories' %>" method="POST" class="p-8 space-y-6">
            
            <div class="grid grid-cols-1 gap-6">
                <!-- Name -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Category Name</label>
                    <input type="text" name="name" value="<%= category.name || '' %>" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                </div>

                <!-- Slug -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Slug (URL friendly)</label>
                    <input type="text" name="slug" value="<%= category.slug || '' %>" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                </div>

                <!-- Icon -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">FontAwesome Icon Class (e.g., 'fas fa-laptop')</label>
                    <input type="text" name="icon" value="<%= category.icon || '' %>" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                </div>
            </div>

            <div class="pt-6 border-t border-slate-100 flex justify-end space-x-4">
                <a href="/admin" class="px-6 py-3 bg-slate-100 text-slate-700 font-bold rounded-xl hover:bg-slate-200 transition-colors">Cancel</a>
                <button type="submit" class="px-6 py-3 bg-gradient-to-r from-primary to-secondary text-white font-bold rounded-xl hover:opacity-90 shadow-lg shadow-primary/30 transition-all transform hover:-translate-y-0.5">
                    Save Category
                </button>
            </div>
        </form>
    </div>
</div>

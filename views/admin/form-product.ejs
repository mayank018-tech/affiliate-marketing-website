<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex items-center justify-between">
        <h1 class="text-3xl font-bold text-slate-800 font-['Outfit']"><%= title %></h1>
        <a href="/admin" class="text-slate-500 hover:text-slate-800 transition-colors">
            <i class="fas fa-arrow-left mr-2"></i> Back to Dashboard
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 overflow-hidden">
        <form action="<%= product.id ? '/admin/products/' + product.id : '/admin/products' %>" method="POST" enctype="multipart/form-data" class="p-8 space-y-6">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Name (Title) -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Product Name</label>
                    <input type="text" name="title" value="<%= product.title || '' %>" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                </div>

                <!-- Slug -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Slug (URL friendly)</label>
                    <input type="text" name="slug" value="<%= product.slug || '' %>" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                </div>

                <!-- Price -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Price (₹) *</label>
                    <input type="number" step="0.01" name="price" value="<%= product.price || '' %>" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                </div>

                <!-- Category -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Category</label>
                    <select name="category_id" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat.id %>" <%= product.category_id === cat.id ? 'selected' : '' %>><%= cat.name %></option>
                        <% }) %>
                    </select>
                </div>
                
                <!-- Link (Affiliate Link) -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Affiliate Link</label>
                    <input type="url" name="affiliate_link" value="<%= product.affiliate_link || '' %>" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all placeholder-slate-400" placeholder="https://amazon.com/dp/...">
                </div>

                <!-- Photos (Local Upload) -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Upload Photos</label>
                    <input type="file" name="images" multiple accept="image/*" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                    <% if (product.image_urls_array && product.image_urls_array.length > 0) { %>
                        <p class="text-xs text-slate-500 mt-2">Currently uploaded: <%= product.image_urls_array.length %> images. Uploading new images will replace them.</p>
                        <div class="flex gap-2 mt-2">
                            <% product.image_urls_array.forEach(img => { %>
                                <img src="<%= img %>" class="w-16 h-16 object-cover rounded-lg border border-slate-200">
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <!-- Photos (Image URL fallback) -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Or Provide External Photo URL (fallback)</label>
                    <input type="url" name="image_url" value="<%= product.image_url || '' %>" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all placeholder-slate-400" placeholder="https://example.com/image.jpg">
                </div>

                <!-- Badge -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Badge Text (Optional, e.g., 'Best Seller')</label>
                    <input type="text" name="badge" value="<%= product.badge || '' %>" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                </div>

                <!-- Description -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Description</label>
                    <textarea name="description" rows="4" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all"><%= product.description || '' %></textarea>
                </div>
            </div>

            <div class="pt-6 border-t border-slate-100 flex justify-end space-x-4">
                <a href="/admin" class="px-6 py-3 bg-slate-100 text-slate-700 font-bold rounded-xl hover:bg-slate-200 transition-colors">Cancel</a>
                <button type="submit" class="px-6 py-3 bg-gradient-to-r from-primary to-secondary text-white font-bold rounded-xl hover:opacity-90 shadow-lg shadow-primary/30 transition-all transform hover:-translate-y-0.5">
                    Save Product
                </button>
            </div>
        </form>
    </div>
</div>

<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex items-center justify-between">
        <div class="flex items-center space-x-4">
            <a href="/admin" class="text-slate-500 dark:text-[#E1DCC9] hover:text-primary dark:hover:text-indigo-400 transition-colors bg-white dark:bg-[#412D15]/40 w-10 h-10 rounded-full flex items-center justify-center shadow-sm border border-slate-200/50 dark:border-[#412D15]/30">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h1 class="text-3xl font-extrabold text-slate-800 dark:text-[#E1DCC9] font-sans tracking-tight"><%= title %></h1>
        </div>
    </div>

    <div class="glass-card rounded-[2rem] overflow-hidden border border-slate-205/50 dark:border-[#412D15]/30 bg-white/40 dark:bg-[#412D15]/10">
        <form action="<%= product.id ? '/admin/products/' + product.id : '/admin/products' %>" method="POST" enctype="multipart/form-data" class="p-8 space-y-6">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Name (Title) -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-350 mb-2">Product Name</label>
                    <input type="text" name="title" value="<%= product.title || '' %>" required class="w-full px-4 py-3 bg-white/60 dark:bg-[#412D15]/40 border border-slate-200 dark:border-[#412D15]/50 rounded-xl text-slate-800 dark:text-[#E1DCC9] focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                </div>

                <!-- Slug -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-350 mb-2">Slug (URL friendly)</label>
                    <input type="text" name="slug" value="<%= product.slug || '' %>" required class="w-full px-4 py-3 bg-white/60 dark:bg-[#412D15]/40 border border-slate-200 dark:border-[#412D15]/50 rounded-xl text-slate-800 dark:text-[#E1DCC9] focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                </div>

                <!-- Price -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-350 mb-2">Price (₹) *</label>
                    <input type="number" step="0.01" name="price" value="<%= product.price || '' %>" required class="w-full px-4 py-3 bg-white/60 dark:bg-[#412D15]/40 border border-slate-200 dark:border-[#412D15]/50 rounded-xl text-slate-800 dark:text-[#E1DCC9] focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                </div>

                <!-- Category -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-350 mb-2">Category</label>
                    <select name="category_id" required class="w-full px-4 py-3 bg-white/60 dark:bg-[#412D15]/40 border border-slate-200 dark:border-[#412D15]/50 rounded-xl text-slate-800 dark:text-[#E1DCC9] focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat.id %>" <%= product.category_id === cat.id ? 'selected' : '' %> class="text-slate-800 dark:bg-[#1F150C]"><%= cat.name %></option>
                        <% }) %>
                    </select>
                </div>
                
                <!-- Link (Affiliate Link) -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-350 mb-2">Affiliate Link</label>
                    <input type="url" name="affiliate_link" value="<%= product.affiliate_link || '' %>" required class="w-full px-4 py-3 bg-white/60 dark:bg-[#412D15]/40 border border-slate-200 dark:border-[#412D15]/50 rounded-xl text-slate-800 dark:text-[#E1DCC9] focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all placeholder-slate-400" placeholder="https://amazon.com/dp/...">
                </div>

                <!-- Photos (Local Upload) -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-350 mb-2">Upload Photos</label>
                    <input type="file" name="images" multiple accept="image/*" class="w-full px-4 py-3 bg-white/60 dark:bg-[#412D15]/40 border border-slate-200 dark:border-[#412D15]/50 rounded-xl text-slate-850 dark:text-[#E1DCC9] focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                    <% if (product.image_urls_array && product.image_urls_array.length > 0) { %>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">Currently uploaded: <%= product.image_urls_array.length %> images. Uploading new images will replace them.</p>
                        <div class="flex gap-2.5 mt-2">
                            <% product.image_urls_array.forEach(img => { %>
                                <img src="<%= img %>" class="w-16 h-16 object-cover rounded-lg border border-slate-200 dark:border-[#412D15]/40 bg-white/80">
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <!-- Photos (Image URL fallback) -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-350 mb-2">Or Provide External Photo URL (fallback)</label>
                    <input type="url" name="image_url" value="<%= product.image_url || '' %>" class="w-full px-4 py-3 bg-white/60 dark:bg-[#412D15]/40 border border-slate-200 dark:border-[#412D15]/50 rounded-xl text-slate-800 dark:text-[#E1DCC9] focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all placeholder-slate-400" placeholder="https://example.com/image.jpg">
                </div>

                <!-- Badge -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-350 mb-2">Badge Text (Optional, e.g., 'Best Seller')</label>
                    <input type="text" name="badge" value="<%= product.badge || '' %>" class="w-full px-4 py-3 bg-white/60 dark:bg-[#412D15]/40 border border-slate-200 dark:border-[#412D15]/50 rounded-xl text-slate-800 dark:text-[#E1DCC9] focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                </div>

                <!-- Description -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-350 mb-2">Description</label>
                    <textarea name="description" rows="4" required class="w-full px-4 py-3 bg-white/60 dark:bg-[#412D15]/40 border border-slate-200 dark:border-[#412D15]/50 rounded-xl text-slate-800 dark:text-[#E1DCC9] focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all"><%= product.description || '' %></textarea>
                </div>
            </div>

            <div class="pt-6 border-t border-slate-200/50 dark:border-[#412D15]/40 flex justify-end space-x-4">
                <a href="/admin" class="px-6 py-3 bg-slate-100 dark:bg-[#412D15]/45 text-slate-700 dark:text-[#E1DCC9] font-bold rounded-xl hover:bg-slate-200 dark:hover:bg-[#412D15]/60 transition-colors">Cancel</a>
                <button type="submit" class="px-6 py-3 bg-gradient-to-r from-primary to-secondary text-white font-bold rounded-xl hover:opacity-95 shadow-lg shadow-primary/20 transition-all transform hover:-translate-y-0.5">
                    Save Product
                </button>
            </div>
        </form>
    </div>
</div>

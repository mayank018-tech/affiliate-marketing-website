<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-900 dark:text-[#E1DCC9] tracking-tight">Admin Dashboard</h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Manage categories and affiliate products in real-time</p>
        </div>
        <a href="/admin/logout" class="bg-red-50 hover:bg-red-100 dark:bg-red-950/30 dark:hover:bg-red-950/50 text-red-650 dark:text-red-400 px-5 py-2.5 rounded-xl font-bold transition-all flex items-center border border-red-205/30">
            <i class="fas fa-sign-out-alt mr-2"></i> Logout
        </a>
    </div>

    <!-- Categories Section -->
    <div class="glass-card rounded-[2rem] overflow-hidden mb-12 border border-slate-205/50 dark:border-[#412D15]/30">
        <div class="p-6 border-b border-slate-200/50 dark:border-[#412D15]/40 flex justify-between items-center bg-white/40 dark:bg-[#412D15]/20">
            <div>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white">Categories</h2>
                <p class="text-xs text-slate-555 dark:text-slate-400">Organize your products with descriptive groups</p>
            </div>
            <a href="/admin/categories/new" class="bg-gradient-to-r from-primary to-secondary text-white px-5 py-2.5 rounded-xl hover:opacity-95 transition-all text-sm font-bold shadow-md shadow-primary/20 flex items-center">
                <i class="fas fa-plus mr-2"></i> Add Category
            </a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-100/50 dark:bg-[#412D15]/35 text-slate-500 dark:text-[#E1DCC9]/70 text-xs font-semibold uppercase tracking-wider">
                    <tr>
                        <th class="px-6 py-4">Name</th>
                        <th class="px-6 py-4">Slug</th>
                        <th class="px-6 py-4">Icon</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-[#412D15]/30 text-sm">
                    <% categories.forEach(c => { %>
                        <tr class="hover:bg-slate-50/40 dark:hover:bg-[#412D15]/20 transition-colors">
                            <td class="px-6 py-4 font-semibold text-slate-900 dark:text-[#E1DCC9]"><%= c.name %></td>
                            <td class="px-6 py-4 text-slate-600 dark:text-slate-400 font-mono text-xs"><%= c.slug %></td>
                            <td class="px-6 py-4 text-slate-700 dark:text-[#E1DCC9]"><span class="w-9 h-9 rounded-lg bg-indigo-50 dark:bg-[#412D15]/50 flex items-center justify-center text-primary dark:text-indigo-400"><i class="fas <%= c.icon %>"></i></span></td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end space-x-3">
                                    <a href="/admin/categories/<%= c.id %>/edit" class="bg-indigo-50 dark:bg-indigo-950/40 hover:bg-indigo-100 text-primary dark:text-indigo-400 px-3.5 py-1.5 rounded-lg font-bold text-xs transition-colors"><i class="fas fa-edit mr-1"></i> Edit</a>
                                    <form action="/admin/categories/<%= c.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete this category?');">
                                        <button type="submit" class="bg-red-50 dark:bg-red-950/30 hover:bg-red-100 text-red-650 dark:text-red-400 px-3.5 py-1.5 rounded-lg font-bold text-xs transition-colors"><i class="fas fa-trash mr-1"></i> Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Products Section -->
    <div class="glass-card rounded-[2rem] overflow-hidden mb-12 border border-slate-205/50 dark:border-[#412D15]/30">
        <div class="p-6 border-b border-slate-200/50 dark:border-[#412D15]/40 flex justify-between items-center bg-white/40 dark:bg-[#412D15]/20">
            <div>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white">Products</h2>
                <p class="text-xs text-slate-555 dark:text-slate-400">Affiliate products featured on the discovery platform</p>
            </div>
            <a href="/admin/products/new" class="bg-gradient-to-r from-primary to-secondary text-white px-5 py-2.5 rounded-xl hover:opacity-95 transition-all text-sm font-bold shadow-md shadow-primary/20 flex items-center">
                <i class="fas fa-plus mr-2"></i> Add Product
            </a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-100/50 dark:bg-[#412D15]/35 text-slate-500 dark:text-[#E1DCC9]/70 text-xs font-semibold uppercase tracking-wider">
                    <tr>
                        <th class="px-6 py-4">Product</th>
                        <th class="px-6 py-4">Category</th>
                        <th class="px-6 py-4">Price</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-[#412D15]/30 text-sm">
                    <% products.forEach(p => { %>
                        <tr class="hover:bg-slate-50/40 dark:hover:bg-[#412D15]/20 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-4">
                                    <div class="w-12 h-12 rounded-xl overflow-hidden bg-white/80 dark:bg-[#412D15]/30 flex items-center justify-center p-1 border border-slate-200/50 dark:border-[#412D15]/20 shadow-sm">
                                        <img src="<%= p.cover_image %>" alt="" class="max-w-full max-h-full object-contain rounded-lg">
                                    </div>
                                    <span class="font-semibold text-slate-900 dark:text-[#E1DCC9]"><%= p.title %></span>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-slate-600 dark:text-slate-400"><%= p.category_name %></td>
                            <td class="px-6 py-4 font-bold text-slate-900 dark:text-white">$<%= p.price %></td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end space-x-3">
                                    <a href="/admin/products/<%= p.id %>/edit" class="bg-indigo-50 dark:bg-indigo-950/40 hover:bg-indigo-100 text-primary dark:text-indigo-400 px-3.5 py-1.5 rounded-lg font-bold text-xs transition-colors"><i class="fas fa-edit mr-1"></i> Edit</a>
                                    <form action="/admin/products/<%= p.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete this product?');">
                                        <button type="submit" class="bg-red-50 dark:bg-red-950/30 hover:bg-red-100 text-red-650 dark:text-red-400 px-3.5 py-1.5 rounded-lg font-bold text-xs transition-colors"><i class="fas fa-trash mr-1"></i> Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

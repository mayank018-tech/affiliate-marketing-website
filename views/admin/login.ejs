<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | NexusAffiliate</title>
    <!-- Premium Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        // Check local storage or system preference and apply dark theme immediately
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }

        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Outfit', 'sans-serif'],
                        body: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: '#4f46e5',
                        secondary: '#7c3aed',
                        accent: '#ec4899',
                        dark: '#1F150C',
                        huntBlack: '#000000',
                        huntDark: '#1F150C',
                        huntMedium: '#412D15',
                        huntLight: '#E1DCC9',
                        light: '#f8fafc'
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        h1, h2, h3, h4, h5, h6, .font-bold, .font-semibold { font-family: 'Outfit', sans-serif; }
        .glass-card {
            backdrop-filter: blur(20px) saturate(200%);
            -webkit-backdrop-filter: blur(20px) saturate(200%);
            background-color: rgba(255, 255, 255, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
            transition: background-color 0.3s, border-color 0.3s, box-shadow 0.3s;
        }
        .dark .glass-card {
            background-color: rgba(65, 45, 21, 0.45);
            border: 1px solid rgba(225, 220, 201, 0.08);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);
        }
    </style>
</head>
<body class="bg-[#f0f4f8] text-slate-800 dark:bg-[#1F150C] dark:text-[#E1DCC9] flex h-screen items-center justify-center relative overflow-hidden font-sans transition-colors duration-300">
    <!-- Animated background elements -->
    <div class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-indigo-200/50 dark:bg-indigo-900/10 rounded-full mix-blend-multiply filter blur-[128px] opacity-70"></div>
    <div class="absolute top-[20%] right-[-10%] w-96 h-96 bg-purple-200/50 dark:bg-purple-900/10 rounded-full mix-blend-multiply filter blur-[128px] opacity-70"></div>
    <div class="absolute bottom-[-20%] left-[20%] w-96 h-96 bg-pink-200/50 dark:bg-pink-900/10 rounded-full mix-blend-multiply filter blur-[128px] opacity-70"></div>

    <div class="glass-card p-10 rounded-[2rem] w-full max-w-md relative z-10 mx-4">
        <div class="text-center mb-8">
            <div class="w-16 h-16 bg-gradient-to-br from-primary to-secondary rounded-2xl mx-auto flex items-center justify-center mb-6 shadow-lg shadow-indigo-500/30">
                <i class="fas fa-shield-halved text-white text-2xl"></i>
            </div>
            <h1 class="text-3xl font-extrabold bg-gradient-to-r from-primary to-secondary dark:from-[#E1DCC9] dark:to-white bg-clip-text text-transparent tracking-tight">Nexus Admin</h1>
            <p class="text-slate-500 dark:text-slate-400 mt-2 text-sm">Sign in to manage your platform</p>
        </div>
        
        <% if (error) { %>
            <div class="bg-red-50 dark:bg-red-950/40 text-red-600 dark:text-red-400 p-4 rounded-xl mb-6 text-sm text-center border border-red-200/30">
                <%= error %>
            </div>
        <% } %>
        
        <form method="POST" action="/admin/login" class="space-y-6">
            <div>
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-350 mb-2">Username</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <i class="fas fa-user text-slate-400 dark:text-slate-500"></i>
                    </div>
                    <input type="text" name="username" required class="w-full pl-11 pr-4 py-3 bg-white/60 dark:bg-[#412D15]/40 border border-slate-200 dark:border-[#412D15]/50 rounded-xl text-slate-800 dark:text-[#E1DCC9] placeholder-slate-400 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                </div>
            </div>
            
            <div>
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-350 mb-2">Password</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <i class="fas fa-lock text-slate-400 dark:text-slate-500"></i>
                    </div>
                    <input type="password" name="password" required class="w-full pl-11 pr-4 py-3 bg-white/60 dark:bg-[#412D15]/40 border border-slate-200 dark:border-[#412D15]/50 rounded-xl text-slate-800 dark:text-[#E1DCC9] placeholder-slate-400 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                </div>
            </div>
            
            <button type="submit" class="w-full bg-gradient-to-r from-primary to-secondary text-white font-bold py-3 px-4 rounded-xl hover:opacity-95 shadow-lg shadow-indigo-500/25 transition-all duration-300 mt-4 transform hover:-translate-y-0.5">
                Sign In to Dashboard
            </button>
        </form>
    </div>
</body>
</html>
